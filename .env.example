# ==============================================================================
# Jaishankar AI — Phase 1 Environment Configuration Example
# ==============================================================================

# LLM Credentials & Configuration
# Replace with your actual OpenAI API Key for local non-Docker development
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini

# Backend Settings
# CORS origins must be a JSON array or comma-separated list of allowed URLs
CORS_ORIGINS=["http://localhost:3000"]

# Frontend Settings
# The URL pointing to the FastAPI backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Future Database Configurations (Placeholder for Phase 3)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jaishankar_ai
REDIS_URL=redis://localhost:6379/0
